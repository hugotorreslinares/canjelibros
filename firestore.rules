rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Moderators are listed by uid in `moderators/{uid}`. The doc is created by hand in the
    // Firebase Console — there's no backend that could grant the role — and its mere
    // existence is the permission. Each user may read only their own doc, so the moderator
    // roster isn't public; the client uses that read to decide whether to show the panel.
    function isModerator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    // Client-side already blocks a suspended reader from publishing, proposing or
    // messaging; this is the rule that makes it hold even if that check is bypassed.
    // Missing the field (or the reader doc) reads as not suspended — most readers
    // predate the field.
    function isSuspended() {
      return request.auth != null
        && exists(/databases/$(database)/documents/readers/$(request.auth.uid))
        && get(/databases/$(database)/documents/readers/$(request.auth.uid)).data.suspended == true;
    }

    match /moderators/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Append-only audit trail: a moderator may add entries as themselves and read the log,
    // but nobody — moderators included — can edit or delete one, so the record of what was
    // censored can't be censored in turn.
    match /moderationLog/{entryId} {
      allow read: if isModerator();
      allow create: if isModerator()
        && request.resource.data.moderatorUid == request.auth.uid
        && request.resource.data.action in ['edit', 'delete', 'delete-message', 'suspend', 'unsuspend']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0;
      allow update, delete: if false;
    }

    // Anyone signed in may report a book or a chat message; only moderators read the
    // queue. `resolve` (status open → resolved) is the one edit a moderator may make —
    // the report itself, like the audit log, isn't otherwise rewritable.
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.status == 'open';
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'resolved';
      allow delete: if false;
    }

    // Puntos Librocambio: cuentas del equipo, con libros y encuentro reales. El
    // documento —nombre, barrio, coordenadas, punto de encuentro— lo crea a mano
    // el equipo en la consola, como `moderators`; nadie puede escribirlo desde
    // la app, así que nadie se pone la etiqueta editando su propio perfil. Es
    // público porque el mapa y las fichas la muestran a cualquier visitante.
    match /officials/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /readers/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      // A moderator may flip `suspended` on someone else's account and nothing else —
      // that's the one field the panel's suspend/reactivate action touches.
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        (isModerator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended']))
      );
      allow delete: if false;
    }

    // A public, append-only record of a closed trade, one per confirmation, listing both
    // participants. Lets anyone derive each reader's trade count client-side (same pattern
    // as `ratings`) instead of the `readers/{uid}.trades` field, which only the confirming
    // side could ever increment.
    match /completedTrades/{tradeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if false;
    }

    match /books/{bookId} {
      // Covers are stored inline as data URLs (no Storage bucket, which would require a
      // billing account), so the document itself is the size limit worth guarding: without
      // this cap a client could park hundreds of KB per book in everyone's catalog read.
      function coverOk() {
        return !('cover' in request.resource.data)
          || request.resource.data.cover == null
          || (request.resource.data.cover is string && request.resource.data.cover.size() < 140000);
      }

      allow read: if true;
      allow create: if request.auth != null
        && !isSuspended()
        && request.resource.data.ownerId == request.auth.uid
        && coverOk();
      // Update allowed for the current owner (any change, including giving it away), or for
      // whoever the book is reserved for when they're claiming it as the new owner (completing
      // a trade) — that's the only way a non-owner may ever touch someone else's book.
      // Moderators may also edit or remove any book: that's the content-policy escape hatch
      // for publications that break the site rules (see the moderation panel).
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.resUid == request.auth.uid &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.resUid == null) ||
        // Whoever a book is reserved for may also release it without taking it:
        // cancelling a trade has to free the other side's book, and only the
        // person it is reserved for can prove they are the one giving it up.
        // Owner untouched, resUid only ever cleared — never pointed elsewhere.
        (resource.data.resUid == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.resUid == null) ||
        isModerator()
      ) && coverOk();
      allow delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid || isModerator()
      );
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.raterUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /threads/{threadId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && !isSuspended()
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        allow create: if request.auth != null && !isSuspended()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        allow update: if false;
        // A message is otherwise immutable (see above); a moderator may remove one that
        // was reported, without needing read access to the rest of the conversation —
        // the report already carries a copy of the offending text.
        allow delete: if isModerator();
      }
    }
  }
}
